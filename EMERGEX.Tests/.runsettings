<?xml version="1.0" encoding="utf-8"?>
<RunSettings>

  <RunConfiguration>
    <!-- Playwright drives a real browser; four workers is a safe default on a laptop. -->
    <MaxCpuCount>4</MaxCpuCount>
    <ResultsDirectory>.\TestResults</ResultsDirectory>
  </RunConfiguration>

  <!-- Playwright browser and trace settings. -->
  <Playwright>
    <BrowserName>chromium</BrowserName>
    <ExpectTimeout>10000</ExpectTimeout>
    <LaunchOptions>
      <Headless>true</Headless>
      <SlowMo>0</SlowMo>
    </LaunchOptions>
  </Playwright>

  <NUnit>
    <NumberOfTestWorkers>4</NumberOfTestWorkers>
    <DefaultTimeout>60000</DefaultTimeout>
  </NUnit>

  <LoggerRunSettings>
    <Loggers>
      <Logger friendlyName="html" enabled="True">
        <Configuration>
          <LogFileName>emergex-test-report.html</LogFileName>
        </Configuration>
      </Logger>
      <Logger friendlyName="trx" enabled="True" />
    </Loggers>
  </LoggerRunSettings>

</RunSettings>
